{
  "xsappname": "weather-agent",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Call",
      "description": "Allows calling the weather-agent agent"
    }
  ],
  "role-templates": [
    {
      "name": "AgentCaller",
      "description": "Can call the weather-agent agent",
      "scope-references": ["$XSAPPNAME.Call"]
    }
  ],
    "oauth2-configuration": {
    "redirect-uris": ["https://oauth.pstmn.io/v1/callback"]
  }
}
