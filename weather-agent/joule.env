# Values filled into joule-template/ -> joule/ by scripts/render-joule.sh
# Any of these can be overridden by an environment variable of the same name
# (in CI: workflow inputs or repository variables).
JOULE_AGENT_NAME=weather_agent
JOULE_DISPLAY_NAME=Weather Assistant
JOULE_DESTINATION=WEATHER_AGENT
# auto = from git tag vX.Y.Z, otherwise 1.0.0
JOULE_VERSION=auto
JOULE_DESCRIPTION=Provides the daily weather forecast for the next 5 days for a given city (default: Wroclaw, Poland) via a remote A2A agent.
JOULE_SCENARIO_NAME=weather_forecast
JOULE_SCENARIO_DESCRIPTION=Get the weather forecast for the next 5 days for a city, for example Wroclaw, Poland.
JOULE_RESPONSE_DESCRIPTION=Weather forecast from the Weather Assistant agent
