# Local development credentials — copy to .env and fill in.
# .env is in .gitignore — NEVER commit it.
#
# SAP AI Core service key values (AICORE_AUTH_URL must NOT end with /oauth/token)
AICORE_AUTH_URL=https://<subaccount>.authentication.eu10.hana.ondemand.com
AICORE_CLIENT_ID=<clientid>
AICORE_CLIENT_SECRET=<clientsecret>
AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com
AICORE_RESOURCE_GROUP=default
AICORE_MODEL=gpt-4.1

# Agent settings
DEFAULT_LOCATION=Wroclaw, Poland

# Local dev only — skip XSUAA JWT check (no xsuaa binding outside CF). NEVER set on CF.
AUTH_DISABLED=true

# --- OpenTelemetry --------------------------------------------------------
OTEL_SERVICE_NAME=weather-agent-local
# Option A: print spans to stdout (fallback SDK path only)
# OTEL_CONSOLE_EXPORTER=true
# Option B: export to an OTLP backend (Honeycomb shown)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<KEY>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
